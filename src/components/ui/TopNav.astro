---
const { brand = "VD ANIMATION" } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-[90] text-white">
  <!-- MOBILE -->
  <nav class="mx-auto w-full px-4 py-4 sm:hidden hero-gotham">
    <div class="flex items-center justify-between">
      <a
        href="/sale"
        class="relative text-[11px] font-black uppercase tracking-[0.22em]
               whitespace-nowrap leading-none text-white/95 transition hover:text-white"
      >
        Artworks on sale
      </a>

      <a
        href="/custom"
        class="relative text-[11px] font-black uppercase tracking-[0.22em]
               whitespace-nowrap leading-none text-white/95 transition hover:text-white"
      >
        Order custom art
      </a>
    </div>

    <div class="mt-4 flex justify-center">
      <a href="/" class="group relative flex items-center justify-center">
        <img
          src="/logo/vd-logo.png"
          alt="VD Animation logo"
          class="h-[72px] w-auto opacity-95 transition duration-300
                 group-hover:opacity-100 group-hover:scale-[1.06]
                 drop-shadow-[0_14px_60px_rgba(255,255,255,0.30)]"
          draggable="false"
        />
        <span
          class="pointer-events-none absolute inset-[-18px] rounded-full opacity-0 blur-3xl
                 transition duration-300 group-hover:opacity-100"
          style="background: radial-gradient(circle, rgba(255,255,255,0.28), rgba(255,255,255,0) 65%)"
        ></span>
      </a>
    </div>
  </nav>

  <!-- DESKTOP -->
  <nav class="mx-auto hidden max-w-xl grid-cols-3 items-center px-4 py-6 sm:grid hero-gotham">
    <!-- LEFT -->
    <div class="flex justify-end pr-1">
      <a
        href="/sale"
        class="group relative text-base font-black uppercase
               tracking-[0.32em] whitespace-nowrap leading-none
               text-white/95 transition hover:text-white"
      >
        <span class="relative z-10">Artworks on sale</span>
        <span
          class="absolute -bottom-2 left-0 h-[3px] w-full
                 origin-left scale-x-0 bg-white
                 transition-transform duration-300
                 group-hover:scale-x-100"
        />
      </a>
    </div>

    <!-- CENTER LOGO -->
    <div class="flex justify-center">
      <a href="/" class="group relative flex items-center justify-center">
        <img
          src="/logo/vd-logo.png"
          alt="VD Animation logo"
          class="h-[120px] w-auto opacity-95 transition duration-300
                 group-hover:opacity-100 group-hover:scale-[1.1]
                 drop-shadow-[0_15px_70px_rgba(255,255,255,0.35)]"
          draggable="false"
        />
        <span
          class="pointer-events-none absolute inset-[-24px] rounded-full opacity-0 blur-3xl
                 transition duration-300 group-hover:opacity-100"
          style="background: radial-gradient(circle, rgba(255,255,255,0.35), rgba(255,255,255,0) 65%)"
        ></span>
      </a>
    </div>

    <!-- RIGHT -->
    <div class="flex justify-start pl-1">
      <a
        href="/custom"
        class="group relative text-base font-black uppercase
               tracking-[0.32em] whitespace-nowrap leading-none
               text-white/95 transition hover:text-white"
      >
        <span class="relative z-10">Order custom art</span>
        <span
          class="absolute -bottom-2 left-0 h-[3px] w-full
                 origin-left scale-x-0 bg-white
                 transition-transform duration-300
                 group-hover:scale-x-100"
        />
      </a>
    </div>
  </nav>
</header>
