---
const { brand = "VD ANIMATION" } = Astro.props;
const pathname = Astro.url.pathname;

const LEFT = {
  href: "/sale",
  mobile: "SALE",
  desktop: "ARTWORKS FOR SALE",
};

const RIGHT = {
  href: "/custom",
  mobile: "CUSTOM",
  desktop: "ORDER CUSTOM ART",
};

const LOGO_SRC = "/logo/vd-logo.svg";
const isActive = (href) => pathname.startsWith(href);
---

<header class="fixed inset-x-0 top-0 z-[90] text-white hero-gotham">
  <!-- soft atmosphere (shorter so it feels like overlay, not a bar) -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-14 bg-gradient-to-b from-black/65 via-black/18 to-transparent"></div>

  <!-- ================= MOBILE ================= -->
  <nav
    class="sm:hidden mx-auto w-full px-4
           pt-[calc(env(safe-area-inset-top)+8px)] pb-2"
  >
    <div
      class="
        mx-auto max-w-[520px]
        grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]
        items-center
        gap-x-6
      "
    >
      <!-- LEFT -->
      <a
        href={LEFT.href}
        class="
          justify-self-end
          px-1
          text-[16px] font-black uppercase
          tracking-normal
          whitespace-nowrap leading-none
          text-white/85 transition
          hover:text-white hover:scale-[1.04]
          active:scale-[0.98]
        "
      >
        {LEFT.mobile}
      </a>

      <!-- CENTER LOGO -->
      <a
        href="/"
        class="justify-self-center group relative flex items-center justify-center"
        aria-label={brand}
      >
        <img
          src={LOGO_SRC}
          alt="VD Animation logo"
          class="
            h-[28px] w-auto
            brightness-0 invert
            transition duration-300
            group-hover:scale-[1.02]
            drop-shadow-[0_4px_12px_rgba(0,0,0,0.72)]
          "
          draggable="false"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- RIGHT -->
      <a
        href={RIGHT.href}
        class="
          justify-self-start
          px-1
          text-[16px] font-black uppercase
          tracking-normal
          whitespace-nowrap leading-none
          text-white/85 transition
          hover:text-white hover:scale-[1.04]
          active:scale-[0.98]
        "
      >
        {RIGHT.mobile}
      </a>
    </div>
  </nav>

  <nav class="mx-auto hidden max-w-[700px] grid-cols-3 items-center px-2 py-4 sm:grid">
    <!-- LEFT -->
    <div class="flex justify-end">
      <a
        href={LEFT.href}
        class={`
          text-[20px] font-black uppercase
          tracking-normal
          whitespace-nowrap leading-none
          transition
          ${isActive(LEFT.href)
            ? "text-white scale-[1.02]"
            : "text-white/85 hover:text-white hover:scale-[1.03]"}
        `}
      >
        {LEFT.desktop}
      </a>
    </div>

    <!-- CENTER LOGO -->
    <div class="flex justify-center">
      <a href="/" class="group relative flex items-center justify-center" aria-label={brand}>
        <img
          src={LOGO_SRC}
          alt="VD Animation logo"
          class="
            h-[42px] w-auto
            brightness-0 invert
            transition duration-300
            group-hover:scale-[1.02]
            drop-shadow-[0_6px_18px_rgba(0,0,0,0.75)]
          "
          draggable="false"
          loading="eager"
          decoding="async"
        />
      </a>
    </div>

    <!-- RIGHT -->
    <div class="flex justify-start">
      <a
        href={RIGHT.href}
        class={`
          text-[20px] font-black uppercase
          tracking-normal
          whitespace-nowrap leading-none
          transition
          ${isActive(RIGHT.href)
            ? "text-white scale-[1.02]"
            : "text-white/85 hover:text-white hover:scale-[1.03]"}
        `}
      >
        {RIGHT.desktop}
      </a>
    </div>
  </nav>
</header>
