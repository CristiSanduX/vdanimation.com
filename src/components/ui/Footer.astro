---
const YEAR = new Date().getFullYear();

const LINKS = [
  { href: "/privacy", label: "Privacy Policy" },
  { href: "/terms", label: "Terms" },
  { href: "mailto:vdaofficialbusiness@gmail.com", label: "Contact" },
];

const BUILT_BY_URL = "https://csx.ro";
const BUILT_BY_LABEL = "Built by CSX";
---

<footer class="relative overflow-hidden bg-black text-white selection:bg-white/20">
  <!-- Top separation WITHOUT gap -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/12 to-transparent"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-black/10 via-black/35 to-transparent"></div>

  <!-- Atmospheric glow -->
  <div class="pointer-events-none absolute bottom-0 left-1/2 h-[320px] w-[720px] -translate-x-1/2 rounded-full bg-white/[0.03] blur-[110px]"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 py-14">
    <div class="grid grid-cols-1 items-center gap-10 sm:grid-cols-[1fr_auto_1fr]">
      <!-- LEFT -->
      <div class="flex flex-col items-center gap-2 sm:items-start">
        <div class="text-[11px] font-black uppercase !tracking-[0em] text-white/60">
          VDA Animation
        </div>
        <div class="text-[12px] font-medium !tracking-[0em] text-white/40">
          © {YEAR} All rights reserved.
        </div>
      </div>

      <!-- CENTER -->
      <nav class="flex flex-wrap justify-center gap-x-8 gap-y-4" aria-label="Footer links">
        {LINKS.map((l) => (
          <a
            href={l.href}
            class="group relative text-[11px] font-black uppercase !tracking-[0em] text-white/55 transition-colors duration-200 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20 focus-visible:ring-offset-0"
          >
            {l.label}
            <span class="pointer-events-none absolute -bottom-1 left-0 h-[1px] w-0 bg-white/55 transition-all duration-300 group-hover:w-full"></span>
          </a>
        ))}
      </nav>

      <!-- RIGHT -->
      <div class="flex flex-col items-center gap-2 sm:items-end">
        <a
          href={BUILT_BY_URL}
          target="_blank"
          rel="noreferrer"
          class="group relative text-[10px] font-bold uppercase !tracking-[0em] text-white/45 transition-colors duration-200 hover:text-white/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20 focus-visible:ring-offset-0 rounded-sm px-1 py-2"
          aria-label={BUILT_BY_LABEL}
        >
          {BUILT_BY_LABEL}
          <span class="pointer-events-none absolute -bottom-1 left-1/2 h-[1px] w-0 -translate-x-1/2 bg-white/45 transition-all duration-300 group-hover:w-full"></span>
        </a>
      </div>
    </div>

    <div class="mt-14 flex justify-center">
      <div class="h-[2px] w-14 rounded-full bg-white/7"></div>
    </div>
  </div>
</footer>

<style>
  footer {
    contain: paint;
    font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  }
</style>