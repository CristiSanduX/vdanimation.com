---
import SiteLayout from "../layouts/SiteLayout.astro";
import CinematicGrid from "../components/cinematic/CinematicGrid";
import { cinematicWorks } from "../data/cinematicWorks";
import TopNav from "../components/ui/TopNav.astro";
---

<SiteLayout title="CINEMATIC | VD ANIMATION">
  <TopNav brand="VD ANIMATION" />

  <main class="w-full pt-[80px] sm:pt-[170px]">
    <section class="w-full px-0 pb-6">
      <CinematicGrid items={cinematicWorks} client:idle />
    </section>
  </main>
</SiteLayout>
