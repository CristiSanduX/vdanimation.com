---
// src/pages/custom.astro
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/ui/TopNav.astro";

const ORDER_FORM_URL = "https://forms.gle/CQZWEVTo1oHB4eg67";
const INSTAGRAM_URL = "https://www.instagram.com/vda.aep/";
const EMAIL = "contact@vdanimation.com";

const DISCORD_USERNAME = "@tornado.vda";
const STEAM_USERNAME = "@TorNado";

// ✅ Steam profile link (pune-l pe al tău real)
const STEAM_PROFILE_URL = "https://steamcommunity.com/profiles/76561198357608859";

// ✅ Discord: server invite (din screenshot-ul tău)
const DISCORD_LINK = "https://discord.gg/VDzayArUu9";

// optional: poza locală cu price list
const PRICE_PREVIEW_IMG = "/media/price-list.png";
---

<Layout title="Steam Animated Artwork • VD Animation">
  <TopNav brand="VD ANIMATION" />

  <main class="relative min-h-screen w-full overflow-hidden bg-black text-white">
    <!-- Ambient glows -->
    <div class="pointer-events-none absolute -top-48 left-1/2 h-[620px] w-[620px] -translate-x-1/2 rounded-full bg-white/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-56 right-6 h-[520px] w-[520px] rounded-full bg-white/5 blur-3xl"></div>

    <div class="mx-auto max-w-6xl px-6 pt-28 pb-24">
      <!-- HERO (centered) -->
      <section class="relative text-center">
        <div class="mx-auto inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs tracking-[0.22em] uppercase text-white/80">
          Steam profile • Animated artwork • Limited slots
        </div>

        <h1 class="mx-auto mt-6 max-w-4xl text-4xl font-black tracking-tight sm:text-6xl">
          Steam Animated Artwork
        </h1>

        <p class="mx-auto mt-4 max-w-3xl text-base text-white/70 sm:text-lg">
          Premium animated artwork for your Steam profile — cinematic, clean, optimized for Steam.
          Message me directly and I’ll reply with availability + next steps.
        </p>

        <!-- ✅ CONTACT CTA (Discord + Steam + Email) -->
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:items-center">
          <!-- Discord -->
          <div class="flex w-full flex-col items-center sm:w-auto">
            <a
              href={DISCORD_LINK}
              target="_blank"
              rel="noreferrer"
              class="
                inline-flex w-full items-center justify-center gap-3 rounded-2xl
                bg-[#5865F2] px-6 py-4 text-sm font-black uppercase tracking-[0.22em]
                text-white transition
                hover:scale-[1.02] hover:brightness-110
                sm:w-auto
              "
              aria-label={`Discord ${DISCORD_USERNAME}`}
              title={`Discord: ${DISCORD_USERNAME}`}
            >
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-black/20">
                <!-- Discord icon -->
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="opacity-95">
                  <path
                    d="M20.317 4.369a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.444.864-.608 1.249a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.249.077.077 0 0 0-.079-.037 19.736 19.736 0 0 0-4.885 1.515.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.055 19.9 19.9 0 0 0 5.993 3.03.077.077 0 0 0 .084-.027c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.103 13.17 13.17 0 0 1-1.872-.892.077.077 0 0 1-.008-.127c.126-.095.252-.194.372-.291a.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.061 0a.073.073 0 0 1 .078.009c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.891.077.077 0 0 0-.04.104c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.862 19.862 0 0 0 6.002-3.03.077.077 0 0 0 .031-.054c.5-5.177-.838-9.673-3.548-13.66a.061.061 0 0 0-.031-.028Z"
                    fill="currentColor"
                  />
                  <path
                    d="M8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.21 0 2.175 1.095 2.157 2.418 0 1.334-.956 2.419-2.157 2.419Zm7.974 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.21 0 2.175 1.095 2.157 2.418 0 1.334-.946 2.419-2.157 2.419Z"
                    fill="currentColor"
                  />
                </svg>
              </span>

              <span class="leading-none">
                <span class="block text-[11px] font-black uppercase tracking-[0.22em] opacity-90">Discord</span>
                <span class="block text-sm font-black normal-case tracking-normal">{DISCORD_USERNAME}</span>
              </span>
            </a>

            
          </div>

          <!-- Steam -->
          <a
            href={STEAM_PROFILE_URL}
            target="_blank"
            rel="noreferrer"
            class="
              inline-flex w-full items-center justify-center gap-3 rounded-2xl
              border border-white/18 bg-white/5 px-6 py-4
              text-sm font-black uppercase tracking-[0.22em] text-white/90
              transition hover:scale-[1.02] hover:bg-white/10
              sm:w-auto
            "
            aria-label={`Steam ${STEAM_USERNAME}`}
            title={`Steam: ${STEAM_USERNAME}`}
          >
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/5">
              <!-- Steam icon -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="opacity-95">
                <path
                  d="M16.994 2.01a5.995 5.995 0 0 0-5.88 4.64l-3.71 5.39-3.29 1.35A2.5 2.5 0 0 0 2 15.72c0 1.05.65 1.99 1.63 2.37l4.2 1.64a2.75 2.75 0 0 0 3.61-1.52l.94-2.39 4.26-1.83a6 6 0 1 0 .35-11.98Zm-6.88 16.6a1.5 1.5 0 0 1-1.96.83l-4.2-1.64a1.5 1.5 0 0 1-.86-1.94 1.5 1.5 0 0 1 1.95-.83l2.72 1.06a2.75 2.75 0 0 0 2.53 2.54l-.18.0Zm1.03-3.2a1.75 1.75 0 1 1-1.86-2.89l1.86.73v2.16Zm5.85-2.46a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-6.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z"
                  fill="currentColor"
                />
              </svg>
            </span>
            <span class="leading-none">
              <span class="block text-[11px] font-black uppercase tracking-[0.22em] opacity-90">Steam</span>
              <span class="block text-sm font-black normal-case tracking-normal">{STEAM_USERNAME}</span>
            </span>
          </a>

          <!-- email stays as secondary -->
          <a
            href={`mailto:${EMAIL}`}
            class="text-sm font-black uppercase tracking-[0.22em] text-white/70 hover:text-white"
          >
            Email: {EMAIL}
          </a>
        </div>

        <!-- ✅ Not limited to Steam banner -->
        <div class="mx-auto mt-8 max-w-4xl rounded-3xl border border-white/12 bg-white/5 p-6 text-left">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <div class="text-xs font-black uppercase tracking-[0.28em] text-white/60">
                Not limited to Steam
              </div>
              <div class="mt-2 text-xl font-black">
                I take commissions for multiple formats.
              </div>
              <p class="mt-2 text-sm text-white/70">
                If you want something different, just message me with references and your budget — I’ll tell you what’s possible.
              </p>
            </div>

            <div class="grid gap-2 text-sm text-white/75 sm:min-w-[260px]">
              <div class="rounded-2xl border border-white/10 bg-black/25 px-4 py-3">• Animated backgrounds</div>
              <div class="rounded-2xl border border-white/10 bg-black/25 px-4 py-3">• Stream packs (overlays)</div>
              <div class="rounded-2xl border border-white/10 bg-black/25 px-4 py-3">• Banners / headers</div>
              <div class="rounded-2xl border border-white/10 bg-black/25 px-4 py-3">• Logos + animated logos</div>
              <div class="rounded-2xl border border-white/10 bg-black/25 px-4 py-3">• Profile visuals / themes</div>
            </div>
          </div>
        </div>

        <div class="mx-auto mt-6 max-w-3xl rounded-3xl border border-white/12 bg-white/5 p-5 text-left">
          <div class="text-xs font-black uppercase tracking-[0.28em] text-white/60">Important</div>
          <ul class="mt-3 space-y-2 text-sm text-white/70">
            <li>• Minimum <span class="text-white/90 font-black">50% deposit</span> required to start.</li>
            <li>• Clear references = faster delivery.</li>
            <li>• If complexity grows beyond budget, you’ll confirm before I proceed.</li>
          </ul>
        </div>

        <div class="mt-10 h-px w-full bg-gradient-to-r from-transparent via-white/15 to-transparent"></div>
      </section>

      <!-- WHAT THE FORM ASKS -->
      <section class="mt-14 text-center">
        <h2 class="text-xl font-black uppercase tracking-[0.22em]">What you’ll fill in the form</h2>
        <p class="mx-auto mt-3 max-w-3xl text-sm text-white/65">
          The form is designed to save time for both of us. Here’s exactly what it asks, so you can prepare in 2 minutes.
        </p>

        <div class="mt-6 grid gap-4 lg:grid-cols-3 text-left">
          <div class="rounded-3xl border border-white/12 bg-white/5 p-6">
            <div class="text-xs font-black uppercase tracking-[0.28em] text-white/60">01</div>
            <div class="mt-3 text-lg font-black">Project idea</div>
            <p class="mt-2 text-sm text-white/70">
              What vibe do you want? Anime / cyberpunk / minimal / dark, etc.
            </p>
          </div>

          <div class="rounded-3xl border border-white/12 bg-white/5 p-6">
            <div class="text-xs font-black uppercase tracking-[0.28em] text-white/60">02</div>
            <div class="mt-3 text-lg font-black">Style + main color</div>
            <p class="mt-2 text-sm text-white/70">
              Do you want a specific style? Black & white or custom palette.
            </p>
          </div>

          <div class="rounded-3xl border border-white/12 bg-white/5 p-6">
            <div class="text-xs font-black uppercase tracking-[0.28em] text-white/60">03</div>
            <div class="mt-3 text-lg font-black">What gets animated</div>
            <p class="mt-2 text-sm text-white/70">
              Character, text, logo, effects — and whether you already have the assets.
            </p>
          </div>

          <div class="rounded-3xl border border-white/12 bg-white/5 p-6">
            <div class="text-xs font-black uppercase tracking-[0.28em] text-white/60">04</div>
            <div class="mt-3 text-lg font-black">Background + Theme link</div>
            <p class="mt-2 text-sm text-white/70">
              Steam background (existing) or we pick one. Optional profile theme link.
            </p>
          </div>

          <div class="rounded-3xl border border-white/12 bg-white/5 p-6">
            <div class="text-xs font-black uppercase tracking-[0.28em] text-white/60">05</div>
            <div class="mt-3 text-lg font-black">Budget + over-budget rule</div>
            <p class="mt-2 text-sm text-white/70">
              You pick a range. If complexity increases, you approve before extra work.
            </p>
          </div>

          <div class="rounded-3xl border border-white/12 bg-white/5 p-6">
            <div class="text-xs font-black uppercase tracking-[0.28em] text-white/60">06</div>
            <div class="mt-3 text-lg font-black">Steam permalink + receipt</div>
            <p class="mt-2 text-sm text-white/70">
              Your Steam link + email/name/country for invoice / receipt.
            </p>
          </div>
        </div>
      </section>

      <!-- PACKAGES -->
      <section class="mt-14 text-center">
        <div class="flex flex-col items-center justify-between gap-3 sm:flex-row sm:items-end sm:justify-between">
          <h2 class="text-xl font-black uppercase tracking-[0.22em]">Packs</h2>
          <div class="text-xs uppercase tracking-[0.22em] text-white/55">
            Price varies by complexity
          </div>
        </div>

        <div class="mt-6 grid gap-4 lg:grid-cols-3 text-left">
          <div class="rounded-3xl border border-white/12 bg-white/5 p-7">
            <div class="text-xs font-black uppercase tracking-[0.28em] text-white/60">Classic Pack</div>
            <div class="mt-3 text-2xl font-black">20–50€</div>
            <p class="mt-2 text-sm text-white/70">Clean and effective.</p>
            <div class="mt-6 text-sm text-white/75 leading-6">
              • Character cut<br />
              • Hair / eyes / breath<br />
              • Basic limb motion<br />
              • Clothes motion<br />
              • Particles / subtle FX
            </div>
          </div>

          <div class="rounded-3xl border border-white/20 bg-white/8 p-7">
            <div class="text-xs font-black uppercase tracking-[0.28em] text-white/70">Favorite Pack</div>
            <div class="mt-3 text-2xl font-black">70–120€</div>
            <p class="mt-2 text-sm text-white/70">More detail, stronger impact.</p>
            <div class="mt-6 text-sm text-white/80 leading-6">
              • Everything in Classic<br />
              • Detailed animations<br />
              • High quality polish<br />
              • Better FX layering
            </div>

            <div class="mt-6 rounded-2xl border border-white/12 bg-black/30 p-4 text-xs text-white/70">
              Best choice for most Steam profiles.
            </div>
          </div>

          <div class="rounded-3xl border border-white/12 bg-white/5 p-7">
            <div class="text-xs font-black uppercase tracking-[0.28em] text-white/60">Ultimate Pack</div>
            <div class="mt-3 text-2xl font-black">150€+</div>
            <p class="mt-2 text-sm text-white/70">Maximum quality + advanced work.</p>
            <div class="mt-6 text-sm text-white/75 leading-6">
              • Best quality pipeline<br />
              • 3D manipulation (if needed)<br />
              • Complex FX / camera feeling<br />
              • Animated desktop wallpaper (optional)
            </div>
          </div>
        </div>

        <!-- CTA row under packs (Discord/Steam) -->
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={DISCORD_LINK}
            target="_blank"
            rel="noreferrer"
            class="inline-flex w-full items-center justify-center gap-3 rounded-2xl bg-[#5865F2] px-6 py-4 text-sm font-black uppercase tracking-[0.22em] text-white transition hover:scale-[1.02] hover:brightness-110 sm:w-auto"
          >
            Discord {DISCORD_USERNAME}
          </a>

          <a
            href={STEAM_PROFILE_URL}
            target="_blank"
            rel="noreferrer"
            class="inline-flex w-full items-center justify-center gap-3 rounded-2xl border border-white/20 bg-white/5 px-6 py-4 text-sm font-black uppercase tracking-[0.22em] text-white/90 transition hover:scale-[1.02] hover:bg-white/10 sm:w-auto"
          >
            Steam {STEAM_USERNAME}
          </a>
        </div>
      </section>

      <!-- NOTE: keep your remaining sections (Payment/FAQ/Footer CTA) as-is below -->
      <!-- ... -->
    </div>

    <!-- ✅ Sticky mobile CTA (Discord + Steam) -->
    <div class="fixed inset-x-0 bottom-4 z-50 mx-auto w-[min(680px,calc(100%-2rem))] px-2 sm:hidden">
      <div class="flex gap-3 rounded-2xl border border-white/12 bg-black/70 p-2 backdrop-blur">
        <a
          href={DISCORD_LINK}
          target="_blank"
          rel="noreferrer"
          class="flex-1 rounded-xl bg-[#5865F2] px-4 py-3 text-center text-xs font-black uppercase tracking-[0.22em] text-white"
        >
          Discord
        </a>
        <a
          href={STEAM_PROFILE_URL}
          target="_blank"
          rel="noreferrer"
          class="flex-1 rounded-xl border border-white/20 bg-white/5 px-4 py-3 text-center text-xs font-black uppercase tracking-[0.22em] text-white/90"
        >
          Steam
        </a>
      </div>
    </div>
  </main>

  <!-- ✅ Copy-to-clipboard helper -->
  <script is:inline>
    document.addEventListener("click", async (e) => {
      const btn = e.target.closest("[data-copy]");
      if (!btn) return;
      const value = btn.getAttribute("data-copy");
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const prev = btn.textContent;
        btn.textContent = "Copied ✅";
        setTimeout(() => (btn.textContent = prev), 1200);
      } catch {}
    });
  </script>
</Layout>
