---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/ui/TopNav.astro";
import Footer from "../components/ui/Footer.astro";
---

<Layout title="Privacy Policy • VD Animation">
  <TopNav brand="VD ANIMATION" />

  <main class="mx-auto max-w-4xl px-6 pt-28 pb-16 text-white">
    <h1 class="text-3xl font-black tracking-tight">Privacy Policy</h1>
    <p class="mt-3 text-sm text-white/65">Last updated: {new Date().toISOString().slice(0, 10)}</p>

    <div class="mt-10 space-y-8 text-sm leading-7 text-white/75">
      <section>
        <h2 class="text-base font-black uppercase tracking-[0.22em] text-white/90">Overview</h2>
        <p class="mt-3">
          This website ("VD Animation", "we", "us") showcases digital artworks and provides links to external
          services such as order forms and purchase pages. This Privacy Policy explains what information may
          be collected and how it is used.
        </p>
      </section>

      <section>
        <h2 class="text-base font-black uppercase tracking-[0.22em] text-white/90">Information you provide</h2>
        <p class="mt-3">
          If you place an order through our external form (e.g., Google Forms), you may be asked to provide:
          name, email address, country (for receipts), Steam profile link, references/assets, and project details.
          This information is used only to communicate with you and fulfill your request.
        </p>
      </section>

      <section>
        <h2 class="text-base font-black uppercase tracking-[0.22em] text-white/90">External services</h2>
        <p class="mt-3">
          We may link to third-party platforms (e.g., Google Forms, Instagram, payment processors, external
          purchase pages). Your interaction with those services is governed by their own privacy policies.
          We do not control and are not responsible for third-party practices.
        </p>
      </section>

      <section>
        <h2 class="text-base font-black uppercase tracking-[0.22em] text-white/90">Analytics & cookies</h2>
        <p class="mt-3">
          If analytics tools are enabled in the future, they may collect basic usage data (such as pages visited,
          device type, and approximate location) to help improve the website. If you are using an ad blocker
          or have disabled cookies, analytics may be limited or unavailable.
        </p>
      </section>

      <section>
        <h2 class="text-base font-black uppercase tracking-[0.22em] text-white/90">Data retention</h2>
        <p class="mt-3">
          We retain information only as long as necessary to communicate with you and deliver the requested
          work, comply with legal obligations, resolve disputes, and enforce agreements.
        </p>
      </section>

      <section>
        <h2 class="text-base font-black uppercase tracking-[0.22em] text-white/90">Your rights</h2>
        <p class="mt-3">
          Depending on your location, you may have rights to request access, correction, or deletion of your
          personal data. To make such a request, contact us via the email listed on this website.
        </p>
      </section>

      <section>
        <h2 class="text-base font-black uppercase tracking-[0.22em] text-white/90">Contact</h2>
        <p class="mt-3">
          For privacy-related questions, please contact us using the email address displayed on the site.
        </p>
      </section>
    </div>
  </main>

</Layout>
