---
import SiteLayout from "../layouts/SiteLayout.astro";
import AnimeGrid from "../components/anime/AnimeGrid";
import { animeWorks } from "../data/animeWorks";
import TopNav from "../components/ui/TopNav.astro";
---

<SiteLayout title="ANIME | VD ANIMATION">
  <TopNav brand="VD ANIMATION" />

  <main class="w-full pt-[80px] sm:pt-[170px]">
    <section class="w-full px-0 pb-6">
<AnimeGrid items={animeWorks} client:idle />
    </section>
  </main>
</SiteLayout>
